{{ 'best-sellers-list.css' | asset_url | stylesheet_tag }}


<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-list-wrapper custom-page-width ">
  <div class="best-sellers__section">
    <div class="best-sellers__item-left-column">
           <div class="best-sellers__item-title-block">
             <p class="section-title">{{ section.settings.section_label }}</p>
               <h3 class="collection-title">
                 {{ section.settings.title }}
             </h3>
           </div>
           <div>
            <best-sellers-manager class="best-sellers-list" >
              <ul>
       {%- for block in section.blocks -%}
         {%  assign block_collection = block.settings.collection %}
         {% if block_collection != blank %}
             {% if block.settings.product != blank  %}  
           {%  assign collection_first_product = block.settings.product%}
           {% else %} 
           {%  assign collection_first_product = block_collection.products | first %}
           {% endif %}
         {% if block.settings.collection_handled_title != blank%}  
           {%  assign collection_title = block.settings.collection_handled_title%}
           {% else %} 
           {%  assign collection_title = block_collection.title %}
           {% endif %}
           <li
           class="best-sellers__item {% if forloop.first %}selected {% endif %}"
           {{ block.shopify_attributes }} data-collection-product-id="{{ collection_first_product.selected_or_first_available_variant.id }}"
         >
         <div class="best-sellers__collection" >
             <h4>
              {{collection_title}}
             </h4>
             <div class="arrow"> 
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                 <path d="M14.43 5.92999L20.5 12L14.43 18.07"  stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                 <path d="M3.5 12H20.33" stroke="#9D9D9D" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                 </svg>
             </div>
         </div>
         
         </li>
         {% endif %}
       {%- endfor -%}
       </ul>
     </best-sellers-manager>

           </div>
         </div>
         <product-cards-manager class="best-sellers__item-image-wrapper ">
         {%- for block in section.blocks -%}
           {% if block_collection != blank %}
             {% if block.settings.product != blank  %}  
           {%  assign first_collection_first_product = block.settings.product%}
           {% else %} 
           {%  assign first_collection_first_product = block_collection.products | first %}
           {% endif %}
          {% endif  %} 
          <best-seller-product-card class=" 
          {% unless forloop.first %}hidden 
          {% endunless  %}" data-variant-id="{{ first_collection_first_product.selected_or_first_available_variant.id }}">
          {% if first_collection_first_product.featured_image %}
            <a href={{ first_collection_first_product.url }}>
              <picture >
                  <source
                      srcset="{{ first_collection_first_product.featured_image | img_url: '360x' }} 1x, {{ first_collection_first_product.featured_image  | img_url: '720x' }} 2x"
                      media="(max-width: 991px)"
                  />
                  <img
                      loading="lazy"
                      src="{{ first_collection_first_product.featured_image  | img_url: '1200x' }}"
                      srcset="{{ first_collection_first_product.featured_image  | img_url: '1200x' }} 1x, {{ image | img_url: '2400x' }}, 2x"
                      alt="{{ first_collection_first_product.featured_image .alt | default: shop.name }}"
                  />
              </picture>
            </a>
            {% else %}
             {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
              <div class="best-sellers__item-product-detail">
                <a href={{ first_collection_first_product.url }}>
                  <h4 class="product-title">{{ first_collection_first_product.title }}</h4>
                </a>
                <div class="prices-wrapper">
                  <div class="price">{{ first_collection_first_product.price | money}}</div>
                  {% if first_collection_first_product.compare_at_price %}
                  <div class="compare-at-price">{{collection_first_product.compare_at_price | money }}</div>
                  {% endif %}

                </div>
                </div>
              <div class="icons-wrapper">

                <popup-controller class="best-sellers__item-like" popup-id="wish-list-{{ first_collection_first_product.selected_or_first_available_variant.id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <path d="M20.84 4.61012C20.3292 4.09912 19.7228 3.69376 19.0554 3.4172C18.3879 3.14064 17.6725 2.99829 16.95 2.99829C16.2275 2.99829 15.5121 3.14064 14.8446 3.4172C14.1772 3.69376 13.5708 4.09912 13.06 4.61012L12 5.67012L10.94 4.61012C9.90831 3.57842 8.50903 2.99883 7.05 2.99883C5.59096 2.99883 4.19169 3.57842 3.16 4.61012C2.1283 5.64181 1.54871 7.04108 1.54871 8.50012C1.54871 9.95915 2.1283 11.3584 3.16 12.3901L4.22 13.4501L12 21.2301L19.78 13.4501L20.84 12.3901C21.351 11.8794 21.7564 11.2729 22.0329 10.6055C22.3095 9.93801 22.4518 9.2226 22.4518 8.50012C22.4518 7.77763 22.3095 7.06222 22.0329 6.39476C21.7564 5.7273 21.351 5.12087 20.84 4.61012V4.61012Z" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </popup-controller>
                <div class="best-seller-image-eye {% unless first_collection_first_product.selected_or_first_available_variant.available  %} disabled{% endunless %}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M15.58 11.9999C15.58 13.9799 13.98 15.5799 12 15.5799C10.02 15.5799 8.42001 13.9799 8.42001 11.9999C8.42001 10.0199 10.02 8.41992 12 8.41992C13.98 8.41992 15.58 10.0199 15.58 11.9999Z" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 20.27C15.53 20.27 18.82 18.19 21.11 14.59C22.01 13.18 22.01 10.81 21.11 9.39997C18.82 5.79997 15.53 3.71997 12 3.71997C8.47 3.71997 5.18 5.79997 2.89 9.39997C1.99 10.81 1.99 13.18 2.89 14.59C5.18 18.19 8.47 20.27 12 20.27Z" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                </div>
              </div>
              <div class="best-sellers__item-tags">
                {%- for tag in  first_collection_first_product.tags -%}
                  {% if forloop.index < 4 %}
                  {% assign tag_lower_case = tag |  downcase %}
                  <div class="best-sellers__item-tag {% if  tag_lower_case == "sale"%} bg-red{% endif %}">{{tag}}</div>
                  {% endif %}
                {%- endfor -%}
              </div>
            </best-seller-product-card>
            {% assign popup_text =   first_collection_first_product.selected_or_first_available_variant.id | prepend: "wish-list-" %}
            {% render 'custom-popup' with popupId: popup_text, productTitle: first_collection_first_product.title %}
            {%- endfor -%}
            </product-cards-manager>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.best-sellers.name",
  "tag": "section",
  "class": "section ",
  "max_blocks": 15,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "section_label",
      "default": "t:sections.best-sellers.settings.section_label.default",
      "label": "t:sections.best-sellers.settings.section_label.label"
    },
    {
      "type": "text",
      "id": "title",
      "default": "t:sections.best-sellers.settings.title.default",
      "label": "t:sections.best-sellers.settings.title.label"
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "t:sections.best-sellers.blocks.featured_collection.name",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "collection_handled_title",
          "label": "t:sections.best-sellers.blocks.featured_collection.settings.custom_collection_title.label"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.best-sellers.blocks.featured_collection.settings.collection.label"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.best-sellers.blocks.featured_collection.settings.first_product.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.best-sellers.presets.name",
      "blocks": [
        {
          "type": "featured_collection"
        }
      ]
    }
  ]
}
{% endschema %}
